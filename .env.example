LLM_API_KEY=your_api_key_here
OPENROUTER_MANAGEMENT_KEY=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=autoresearch-book-summary-benchmark
GOOGLE_BOOKS_API_KEY=

# ── Cloud Function transport (autoresearch/run_candidate) ──
# Loaded automatically by core/run_candidate.py and autoresearch/agent.py.
FUNCTION_URL=https://summarize-<HASH>-uc.a.run.app
AUTH_MODE=oidc                # auto | oidc | env | none
CF_TIMEOUT=600                # seconds; thinking models can take 5-10 min
# GCP_IDENTITY_TOKEN=          # static OIDC token for CI (AUTH_MODE=env)
